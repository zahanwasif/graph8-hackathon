generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

/// An event: a Slack channel bound to one graph8 campaign, plus the pointers to
/// the graph8 objects that hold this event's actual content. graph8 is the source
/// of truth — the campaign owns name/goal/target-persona/audience/cadence; a
/// studio persona owns the target profile. This row is the thin binding graph8
/// can't represent (the Slack channel, the per-event skill/workflow pointers, the
/// Clerk workspace) plus a small display/scorer cache so list views stay fast.
model Event {
  id             String    @id @default(cuid())
  name           String // display cache — graph8 campaign is source of truth
  date           DateTime?
  goal           String? // display cache — mirrors the campaign's goal
  slackChannelId String    @unique // routing key: a message in this channel → this event. No graph8 home.

  // Owning workspace (Clerk org id). Nullable while the only way to make an Event is the seed;
  // the future `/debrief event` command sets it. Until then the captures API also shows
  // unassigned (null) events so seeded data is visible.
  workspaceId String?

  // Scorer-input cache of the target-profile text fed to the extract skill as
  // {target_profile}. Source of truth is the graph8 persona / campaign target_persona;
  // cached here so scoring needs no round-trip.
  targetProfile String?

  // --- graph8 pointers (the content + steps live in graph8) ---
  graph8CampaignId       String? // THE backbone: name/goal/target_persona/audience/cadence live here
  graph8PersonaId        String? // studio persona (target profile / ICP)
  graph8ExtractSkillId   String? // LLM skill: transcript -> structured lead + disposition
  graph8DraftSkillId     String? // LLM skill: draft the follow-up
  graph8PipelineId       String? // deal pipeline (stages)
  graph8ListId           String? // audience list for this event
  graph8SequenceId       String? // cadence sequence (created when the campaign is launched)
  graph8IntakeWorkflowId String? // form-intake workflow: create contact → enrich → score → add to list
  graph8HotWorkflowId    String? // hot-lead workflow (alerts, delay, voice call)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  captures Capture[]
  leads    Lead[]

  @@index([workspaceId])
}

/// One lead added through the graph8 intake workflow (the "Add lead" button / a form). graph8 is
/// the source of truth for the contact + its criteria_score; this row tracks the *pipeline status*
/// graph8's list can't express (processing/failed) and caches the person + score for the Leads tab.
model Lead {
  id          String  @id @default(cuid())
  eventId     String
  event       Event   @relation(fields: [eventId], references: [id])
  workspaceId String?

  // Set when the lead came from a Slack capture (auto-queued); null for the manual "Add lead" button.
  captureId String?  @unique
  capture   Capture? @relation(fields: [captureId], references: [id])

  // Submitted lead fields (also the display cache for name/company/title).
  email   String?
  name    String?
  title   String?
  company String?

  // graph8 pointers + async run tracking.
  graph8ContactId   String?
  graph8ExecutionId String?

  status      LeadStatus @default(PROCESSING)
  fitScore    Int? // mirror of the graph8 criteria_score field
  disposition String?
  error       String?

  /// Snapshot of the graph8 contact's enriched fields (LinkedIn, phone, seniority, company,
  /// location…), captured once when the run completes. Shape: `EnrichedContact` in lib/types.
  enriched Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([workspaceId])
}

/// Pipeline status of a lead's intake run — graph8's list only holds finished contacts, so
/// processing/failed states live here.
enum LeadStatus {
  PROCESSING
  COMPLETED
  FAILED
}

/// One captured conversation = one Slack thread. This is the Slack-ingestion +
/// orchestration record graph8 can't represent (thread mapping, dedupe, pipeline
/// status). The lead itself lives in graph8 (a contact + its criteria_score field),
/// pointed to by `graph8ContactId`. The person/score fields below are a display
/// cache so the Captures list renders without a graph8 round-trip — necessary
/// because the graph8 SDK can't read custom-field values back, and email-less
/// captures never become graph8 contacts at all.
model Capture {
  id             String @id @default(cuid())
  eventId        String
  event          Event  @relation(fields: [eventId], references: [id])
  slackChannelId String
  slackThreadTs  String // root message ts = thread id
  slackUserId    String // operator who captured
  slackEventId   String @unique // Slack event_id, for dedupe on retries

  inputType  InputType
  rawText    String? // transcript or text
  caption    String? // typed text posted alongside a voice/video note
  matchedTag String? // capture hashtag that triggered this capture, without '#'

  // Voice/video note source (Slack file), transcribed with Deepgram into rawText
  slackFileId      String?
  mediaMimeType    String?
  mediaDurationSec Float?
  extraction       Json? // structured output from the graph8 extract skill

  status CaptureStatus @default(RECEIVED)

  // --- graph8 pointers (the lead lives in graph8; these are the source of truth) ---
  graph8ContactId   String?
  graph8CompanyId   String?
  graph8ExecutionId String? // skill/workflow execution id, for async polling

  // --- display cache (graph8 contact + criteria_score field are the source of truth) ---
  personName    String?
  personTitle   String?
  personCompany String?
  // Contact fields pulled from rawText by Groq (`src/server/capture/contact.ts`)
  personEmail     String? // work email only; free-mail addresses are dropped
  personFirstName String?
  personLastName  String?
  summary       String?
  nextStep      String?
  // Disposition is a free-text label RETURNED BY graph8 (STRONG_FIT / MAYBE / PASS,
  // or HOT / WARM / COLD) — owned by the graph8 skill, intentionally not a local enum.
  disposition   String?
  fitScore      Int? // 0-100 fit score, mirrored to the graph8 criteria_score field

  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threadState ThreadState?
  lead        Lead?

  @@unique([slackChannelId, slackThreadTs])
}

/// Live conversation state for a capture's Slack thread (disambiguation,
/// missing-info, approval). Pure Slack UX state — graph8 has no notion of it.
model ThreadState {
  id        String    @id @default(cuid())
  captureId String    @unique
  capture   Capture   @relation(fields: [captureId], references: [id])
  state     ConvState @default(IDLE)
  payload   Json? // e.g. disambiguation candidates
  updatedAt DateTime  @updatedAt
}

/// Maps a Slack operator (and their Clerk web identity) to a graph8 owner used
/// for contacts/deals/tasks.
model OperatorMap {
  slackUserId  String  @id
  clerkUserId  String? @unique // web dashboard identity (Clerk)
  graph8UserId String? // owner for contacts/deals/tasks
  displayName  String?
  signature    String? // email sign-off
}

// Workspaces and members live in Clerk (Organizations) — `workspaceId` columns hold the Clerk
// `org_...` id. There is no local mirror of users or workspaces yet.

/// A workspace's Slack install: one bot per workspace, posting to one chosen channel.
model SlackConnection {
  id                String   @id @default(cuid())
  workspaceId       String   @unique @map("workspace_id")
  teamId            String   @map("team_id")
  teamName          String   @map("team_name")
  botUserId         String   @map("bot_user_id")
  /// Bot token (xoxb-…), encrypted with `src/server/crypto/secret-box.ts`. Never sent to the client.
  accessToken       String   @map("access_token")
  grantedScopes     String[] @map("granted_scopes")
  channelId         String?  @map("channel_id")
  channelName       String?  @map("channel_name")
  /// Hashtags (lowercase, no '#') that mark a message for capture, e.g. `add-contact`.
  captureTags       String[] @default(["add-contact"]) @map("capture_tags")
  connectedByUserId String   @map("connected_by_user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([teamId])
  @@map("slack_connections")
}

enum InputType {
  VOICE
  TEXT
  IMAGE
  LINK
}

/// Pipeline stage of a capture within Debrief (not a business disposition —
/// that is `Capture.disposition`, owned by graph8).
enum CaptureStatus {
  RECEIVED
  EXTRACTED
  AWAITING_INFO
  AWAITING_DISAMBIGUATION
  RECORDED
  AWAITING_APPROVAL
  COMPLETED
  FAILED
}

enum ConvState {
  IDLE
  AWAITING_INFO
  AWAITING_DISAMBIGUATION
  AWAITING_APPROVAL
  AWAITING_EDIT
}
