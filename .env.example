# Copy to .env.local and fill in. Mirror these in Vercel → Settings → Environment Variables.

# Clerk (dashboard.clerk.com → API keys). Enable Organizations in the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon: DATABASE_URL is the pooled URL (runtime); DIRECT_URL the unpooled one (migrations).
DATABASE_URL=
DIRECT_URL=

# Slack app (api.slack.com/apps → Basic Information)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Basic Information → App Credentials → Signing Secret. Verifies Events API requests.
SLACK_SIGNING_SECRET=

# Deepgram (console.deepgram.com → API Keys). Transcribes Slack voice/video notes.
DEEPGRAM_API_KEY=

# AES-256-GCM key for stored integration tokens. Generate: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# Public base URL; builds the Slack OAuth redirect (<url>/api/integrations/slack/callback).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# graph8 (app.graph8.com → Settings → MCP & API → API tab). The brain / system of record:
# LLM skills, CRM, lists, deals, workflows. GRAPH8_API_URL is optional (defaults to be.graph8.com).
GRAPH8_API_KEY=
GRAPH8_API_URL=
